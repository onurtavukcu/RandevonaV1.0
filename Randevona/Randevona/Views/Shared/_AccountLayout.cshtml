<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Randevona</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
</head>
<body>
    <header class="account-header">
        <a class="account-brand" asp-controller="Home" asp-action="Index" aria-label="Randevona home">
            <span class="brand-mark" aria-hidden="true">r.</span> Randevona
        </a>
        <span class="header-caption">Appointments made easier.</span>
    </header>
    <main class="account-shell">
        <aside class="account-story" aria-label="About Randevona">
            <span class="story-label">SAVE TIME FOR YOUR BUSINESS</span>
            <h2>Appointments in one place.<br />Focus on your business.</h2>
            <p>Connect with your customers on WhatsApp. Manage appointments, your team and branches in one place.</p>
            <div class="story-note">
                <span class="note-icon" aria-hidden="true">✓</span>
                <div><strong>A start that fits your business</strong><p>For a single branch or a growing team.</p></div>
            </div>
        </aside>
        <section class="account-card" aria-labelledby="account-title">
            @RenderBody()
        </section>
    </main>
    <footer class="account-footer">Randevona · Appointment management</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

