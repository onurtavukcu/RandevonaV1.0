@using Domain.Models.Identity.User.UserInformation
@inject CommonServices.WorkContext.ContextHolderMiddleware.TenantWorkContextHolder ContextHolder
@{
    var admin = User.IsInRole(nameof(SystemUserRoleType.SuperAdmin));
    var workspace = ContextHolder.Value;
    var tenantName = workspace?.TenantName ?? (admin ? "Platform administration" : "Workspace");
    var organizationName = workspace?.OrganizationName ?? (admin ? "No business selected" : "Organization");
    var signedIn = User.Identity?.IsAuthenticated == true;
    var accountName = User.Identity?.Name ?? "Guest";
    var initial = accountName.Length > 0 ? accountName[..1].ToUpperInvariant() : "R";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Randevona</title>
    <link rel="stylesheet" href="~/lib/tabler/tabler.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="workspace">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="app-shell">
        <partial name="_Sidebar" />
        <button class="sidebar-backdrop" type="button" aria-label="Close navigation" tabindex="-1"></button>
        <div class="workspace-main">
            <header class="workspace-topbar">
                <button class="sidebar-toggle icon-button" type="button" aria-label="Open navigation" aria-controls="workspace-sidebar" aria-expanded="false">
                    <partial name="_NavIcon" model='@("menu")' />
                </button>
                <div class="workspace-context">
                    <span class="context-icon"><partial name="_NavIcon" model='@("building")' /></span>
                    <div class="context-value"><span class="context-label">@(admin ? "Workspace" : "Tenant")</span><strong title="@tenantName">@tenantName</strong></div>
                    <span class="context-divider"></span>
                    <div class="context-value organization-context"><span class="context-label">Organization</span><strong title="@organizationName">@organizationName</strong></div>
                </div>
                <div class="topbar-account">
                    <span class="language-label">EN</span>
                    <span class="account-avatar" aria-hidden="true">@initial</span>
                    <div class="account-details"><strong title="@accountName">@accountName</strong><span>@(admin ? "Super administrator" : "Business account")</span></div>
                    @if (signedIn)
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button class="icon-button" type="submit" aria-label="Sign out" title="Sign out"><partial name="_NavIcon" model='@("logout")' /></button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm">Sign in</a>
                    }
                </div>
            </header>
            <main id="main-content" class="workspace-content" tabindex="-1">
                @if (admin)
                {
                    <div class="admin-workspace-bar">
                        <span>@(workspace is null ? "Platform management" : $"Managing {workspace.TenantName} / {workspace.OrganizationName} as a platform administrator")</span>
                        <div class="d-flex gap-2 flex-wrap">
                            <a class="btn btn-sm" asp-controller="Management" asp-action="Tenants">Choose business</a>
                            @if (User.HasClaim(x => x.Type == CommonServices.Authorization.AdminWorkspaceClaims.TenantId))
                            {
                                <form asp-controller="Management" asp-action="ClearWorkspace" method="post"><button class="btn btn-sm" type="submit">Stop managing</button></form>
                            }
                        </div>
                    </div>
                }
                <div class="page-heading">
                    <div class="page-pretitle">@(ViewData["Section"] ?? "Workspace")</div>
                    <h1>@ViewData["Title"]</h1>
                </div>
                @RenderBody()
            </main>
            <footer class="workspace-footer"><span>© @DateTime.UtcNow.Year Randevona</span><a asp-controller="Home" asp-action="Privacy">Privacy</a></footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/workspace.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
