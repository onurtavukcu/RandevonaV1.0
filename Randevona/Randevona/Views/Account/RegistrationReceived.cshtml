@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Başvurunuz alındı";
}
<span class="form-eyebrow">BAŞVURUNUZ ALINDI</span>
<h1 id="account-title">Onay bekleniyor</h1>
<p class="form-intro">Kayıt başvurunuz alındı. Hesabınız yönetici tarafından onaylandıktan sonra işletmenizi yönetmeye başlayabilirsiniz.</p>
<p class="preview-notice">Şu an giriş yapamazsınız. Başvurunuzu yeniden göndermenize gerek yok.</p>
<a class="btn account-submit" asp-controller="Account" asp-action="Login">Giriş ekranına dön <span aria-hidden="true">→</span></a>
