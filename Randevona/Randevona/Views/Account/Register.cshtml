@model Randevona.Models.Account.RegisterViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Create account";
}
<span class="form-eyebrow">A FRESH START</span>
<h1 id="account-title">Create account</h1>
<p class="form-intro">Start by telling us about yourself and your business.</p>
<p class="preview-notice">Your account will become available after administrator approval.</p>
<form asp-controller="Account" asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <div class="field-row">
        <div class="field">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" autocomplete="given-name" aria-describedby="first-name-error" />
            <span asp-validation-for="FirstName" id="first-name-error" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" autocomplete="family-name" aria-describedby="last-name-error" />
            <span asp-validation-for="LastName" id="last-name-error" class="field-error"></span>
        </div>
    </div>
    <div class="field-row">
        <div class="field">
            <label asp-for="CompanyName" class="form-label"></label>
            <input asp-for="CompanyName" class="form-control" autocomplete="organization" aria-describedby="company-error" />
            <span asp-validation-for="CompanyName" id="company-error" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="OrganizationName" class="form-label"></label>
            <input asp-for="OrganizationName" class="form-control" placeholder="e.g. Downtown" aria-describedby="branch-help branch-error" />
            <small id="branch-help" class="field-help">Choose a name for your first branch.</small>
            <span asp-validation-for="OrganizationName" id="branch-error" class="field-error"></span>
        </div>
    </div>
    <div class="field">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" type="email" autocomplete="username" placeholder="you@example.com" aria-describedby="email-error" />
        <span asp-validation-for="Email" id="email-error" class="field-error"></span>
    </div>
    <div class="field-row">
        <div class="field">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="password-error" />
            <span asp-validation-for="Password" id="password-error" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-describedby="confirm-password-error" />
            <span asp-validation-for="ConfirmPassword" id="confirm-password-error" class="field-error"></span>
        </div>
    </div>
    <button type="submit" class="btn account-submit">Submit registration <span aria-hidden="true">→</span></button>
</form>
<p class="account-switch">Already have an account? <a asp-controller="Account" asp-action="Login">Sign in</a></p>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

