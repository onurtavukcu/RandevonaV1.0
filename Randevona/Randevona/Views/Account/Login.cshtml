@model Randevona.Models.Account.LoginViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Sign in";
}
<span class="form-eyebrow">WELCOME BACK</span>
<h1 id="account-title">Sign in</h1>
<p class="form-intro">Sign in to manage your business.</p>
<form asp-controller="Account" asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <input asp-for="ReturnUrl" type="hidden" />
    <div class="field">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" type="email" autocomplete="username" placeholder="you@example.com" aria-describedby="email-error" />
        <span asp-validation-for="Email" id="email-error" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" aria-describedby="password-error" />
        <span asp-validation-for="Password" id="password-error" class="field-error"></span>
    </div>
    <div class="form-check remember-me">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn account-submit">Sign in <span aria-hidden="true">→</span></button>
</form>
<p class="account-switch">Don't have an account? <a asp-controller="Account" asp-action="Register">Create account</a></p>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

